# Public
NEXT_PUBLIC_SITE_URL=https://www.recaho.com
# Destination of the header Login link (no public login URL exists on recaho.com yet)
NEXT_PUBLIC_LOGIN_URL=

# Lead delivery (server-only) — configure the webhook, the email channel, or both.
# 1) CRM / automation webhook that accepts the JSON payload documented in docs/DEPLOYMENT.md
CRM_WEBHOOK_URL=
# Optional bearer token for the CRM endpoint
CRM_API_KEY=
# Optional lead source label
CRM_SOURCE=recaho-website

# 2) Email fallback (used when CRM_WEBHOOK_URL is empty)
# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=
# Sales inbox that receives every enquiry
LEAD_NOTIFY_EMAIL=sales@recaho.com
# Verified sender. Keep the Resend test sender until recaho.com is verified in Resend.
LEAD_FROM_EMAIL=Recaho website <onboarding@resend.dev>
